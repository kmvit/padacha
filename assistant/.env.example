# MODO API: ассистент и MODO работают на одном сервере.
MODO_BASE_URL=http://127.0.0.1:8130/v1
MODO_API_KEY=avs_заменить_на_ключ_клиента_padacha

# Инструментов у ассистента нет (демо — просто ссылка, заявки не оформляем).
LLM_MODEL=openai/gpt-4.1-nano

# Домены, с которых виджету можно стучаться сюда
ALLOWED_ORIGINS=https://padacha.ru,https://www.padacha.ru

# Ограничители: чат публичный и оплачивается по токенам
SESSION_TTL_SECONDS=3600
MAX_MESSAGES_PER_SESSION=40
MAX_SESSIONS_PER_IP=5
MAX_MESSAGE_LENGTH=1000
DAILY_MODEL_CALLS=800
MESSAGES_PER_IP_PER_DAY=40
MESSAGES_PER_IP_PER_MINUTE=8
MIN_SECONDS_BETWEEN_MESSAGES=2

HOST=127.0.0.1
PORT=8101
